# Documentation only: Render supplies these server-side values. Never load locally.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://hanuram_runtime:REPLACE_RUNTIME_PASSWORD@REPLACE_RENDER_HOST/hanuram_production_ii23
CONTROL_DATABASE_URL=postgresql+psycopg://hanuram_control:REPLACE_CONTROL_PASSWORD@REPLACE_RENDER_HOST/hanuram_production_ii23
REQUIRE_RLS=true
AUTO_CREATE_TABLES=false
JWT_SECRET=REPLACE_WITH_EXISTING_STABLE_SECRET_32_CHARACTERS_MINIMUM
DATABASE_AUTH_IDENTITY_KEY=
DATABASE_AUTH_STAFF_KEY=
DATABASE_AUTH_JOBS_KEY=
REDIS_URL=REPLACE_WITH_RENDER_REDIS_URL
CAMPAIGN_TRANSPORT=celery
WHATSAPP_SENDING_ENABLED=false
MEDIA_STORAGE_BACKEND=r2
R2_ENDPOINT_URL=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=hanuram-media-prod
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_GRAPH_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
WHATSAPP_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN_ENCRYPTION_KEY=
ENFORCE_SUBSCRIPTION=true
ENFORCE_WHATSAPP_CONSENT=true
ENABLE_DISTRIBUTED_LIMITS=true
ENABLE_REDIS_PROGRESS=true
ENABLE_SOCKET_PROGRESS=false
CORS_ORIGINS=https://REPLACE_FRONTEND_HOST
# Operator/migration/backup URLs are deliberately excluded from service settings.
