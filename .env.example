ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://cbd:replace-me@localhost:5432/cm_db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTO_CREATE_TABLES=true
ENABLE_REDIS_PROGRESS=false
ENABLE_SOCKET_PROGRESS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_GRAPH_VERSION=v23.0
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Shared Meta application setup, configured once for the SaaS deployment.
META_APP_ID=
WHATSAPP_SIGNUP_CONFIG_ID=
# Random stable secret, at least 32 characters, or a Fernet key. Back it up securely.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
