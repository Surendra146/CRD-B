# Example only. Merge into your local .env; do not overwrite existing keys.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://hanuram_runtime:REPLACE_LOCAL_RUNTIME_PASSWORD@127.0.0.1:5432/hanuram_dev
CONTROL_DATABASE_URL=postgresql+psycopg://hanuram_control:REPLACE_LOCAL_CONTROL_PASSWORD@127.0.0.1:5432/hanuram_dev
REQUIRE_RLS=true
AUTO_CREATE_TABLES=false
# Use the matching existing hanuram_dev authorization keys; do not regenerate.
DATABASE_AUTH_IDENTITY_KEY=
DATABASE_AUTH_STAFF_KEY=
DATABASE_AUTH_JOBS_KEY=
JWT_SECRET=REPLACE_WITH_LOCAL_SECRET_AT_LEAST_32_CHARACTERS
REDIS_URL=redis://127.0.0.1:6379/0
CAMPAIGN_TRANSPORT=celery
ENABLE_REDIS_PROGRESS=true
ENABLE_DISTRIBUTED_LIMITS=true
ENABLE_SOCKET_PROGRESS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDIA_STORAGE_BACKEND=local
WHATSAPP_TEMPLATE_MEDIA_ROOT=.template-media
WHATSAPP_SENDING_ENABLED=false
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_GRAPH_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
WHATSAPP_SIGNUP_CONFIG_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN_ENCRYPTION_KEY=
